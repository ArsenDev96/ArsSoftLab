+/**
+ * M1.4K.3: what each lifted full-frame layer holds, in scene px (every pixel with alpha > 0, plus 2 transparent px,
+ * as scripts/m14i2-crop.py measures it). The <img> stays full-frame, so it resamples exactly as before; the clip only
+ * stops the browser painting and invalidating the empty rest of the frame each time the lift moves it. (A lossless
+ * crop drawn through SceneImage's SVG was rejected: Chrome filters an SVG image differently, up to 55/255 on this art.)
+ */
+const LIFTED_BOUNDS: Record<string, SceneRect> = {
+  [`${M14H1}/engineering-body.png`]: { x: 260, y: 382, w: 342, h: 172 },
+  [`${M14F1}/engineering.png`]: { x: 260, y: 382, w: 342, h: 172 },
+  [`${M14H1}/engineering-body-light.png`]: { x: 302, y: 456, w: 54, h: 36 },
+  [`${M14H1}/engineering-chart-light.png`]: { x: 478, y: 394, w: 82, h: 83 },
+};
+
 function Full({ src, name, add, swap, rise }: { src: string; name: string; add?: boolean; swap?: "anim" | "stable"; rise?: boolean }) {
+  const bounds = rise ? LIFTED_BOUNDS[src] : undefined;
   return (
     <SceneImage
       src={src}
       data-eng={name}
       data-eng-swap={swap}
       className={`pointer-events-none absolute inset-0 h-full w-full max-w-none select-none${rise ? " eng-rise" : ""}`}
-      style={add ? { mixBlendMode: "plus-lighter" } : undefined}
+      style={{ ...(add ? { mixBlendMode: "plus-lighter" as const } : undefined), ...(bounds ? clipTo(bounds) : undefined) }}
     />
   );
 }
