# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Local secrets (never commit)
.env
.env*
!.env.example
.claude/settings.local.json

# Logs and temporary files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Visual-check output (docs/<milestone>/ holds the kept evidence)
.visual/
.visual-*/

# Python (dev-only asset generators)
__pycache__/
*.py[cod]
.venv/
venv/

# Experimental build output (NEXT_DIST_DIR, e.g. M1.3H)
.next-*/

# docs/: commit the written record (Markdown, text reports, JSON measurements) and the few images
# that scripts read as inputs or baselines; keep screenshots, recordings and experiments local.
docs/**/*.png
docs/**/*.jpg
docs/**/*.webm
docs/**/*.webp
docs/**/*.zip
docs/**/*.npy
# Approved sources every M1.4F-M1.4H extractor reads (scripts/m14f-extract.py SRC_DIR)
!docs/m1.3k/package/01-source/lab-plate.png
!docs/m1.3k/package/01-source/environment-lines-removed.png
# Station/line masks read by v2-fit.py, m14a-preview.py, playground-contact-unlit.py, hybrid-floor.py
!docs/m1.3i/masks/*.png
docs/m1.3i/masks/preview.png
